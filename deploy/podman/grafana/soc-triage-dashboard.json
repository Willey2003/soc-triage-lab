   "type": "stat",
   "title": "Auto-closed",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(soc_triage_decisions_total{disposition=\"close\"})",
     "legendFormat": "",
