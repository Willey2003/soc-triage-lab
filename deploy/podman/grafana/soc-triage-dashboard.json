  {
   "id": 4,
   "type": "stat",
   "title": "Live accuracy vs lab truth",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(sum(soc_triage_vs_truth_total{outcome=~\"tp|tn\"}) or vector(0)) / clamp_min(sum(soc_triage_vs_truth_total), 1)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Missed malicious (FN)",
   "datasource": {
